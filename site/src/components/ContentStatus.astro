---
import { formatUtcDate, readSkillDownload } from "../lib/skill-download.ts";

const skill = readSkillDownload(import.meta.env.PROD);
---

{skill && (
  <dl class="content-status" aria-label="Content freshness">
    <div>
      <dt>Content last refreshed</dt>
      <dd><time datetime={skill.contentRefreshedAt}>{formatUtcDate(skill.contentRefreshedAt)}</time></dd>
    </div>
    <div>
      <dt>Checked against KSA</dt>
      <dd>{skill.gameBuilds.join(", ")}</dd>
    </div>
  </dl>
)}

<style>
  .content-status {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .content-status > div { margin: 0; }
  dt { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
  dd { margin: 0.25rem 0 0; font-weight: 600; }
</style>
